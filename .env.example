# API authentication — clients must send this in X-API-Key header
API_KEY=change-me-before-deploying

# Ollama — both containers are defined in docker-compose.yml
# Models are auto-pulled on first start (qwen3.5:4b + qwen3-embedding:0.6b)
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
# OLLAMA_BASE_URL is set automatically by docker-compose to http://ollama:11434

# Anthropic Claude (optional fallback — leave empty to use Ollama only)
ANTHROPIC_API_KEY=

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# App
LOG_LEVEL=INFO
APP_VERSION=1.0.0
